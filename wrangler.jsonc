{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-d1-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanstack-d1-database",
      "database_id": "5d0df40f-69a8-4dc0-85eb-c9ab89129429"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "tanstack-task-images"
    }
  ]
}